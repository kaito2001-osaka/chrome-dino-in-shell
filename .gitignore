# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Linker files
*.ilk

# Debugger Files
*.pdb

# Compiled Dynamic libraries
*.so
*.dylib
*.dll
*.so.*


# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# Build output (Makefile TARGET). Anchored to the repository root so a source
# file named `dino` elsewhere would still be tracked.
/dino

# Build directories
build/
Build/
build-*/

# Temporary files
*.tmp
*.log
*.bak
*.swp

# vcpkg
vcpkg_installed/

# debug information files
*.dwo

# test output & cache
Testing/
.cache/

# Hidden editor/tool directories
.*/
# ...but not .github/, or a workflow added later would be untracked and would
# simply never run, with nothing to explain why.
!.github/
